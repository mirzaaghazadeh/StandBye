{
  "name": "@crew/desktop",
  "productName": "Standbye",
  "version": "0.1.0",
  "description": "BYOK desktop app for 24/7 agent teams",
  "author": "Standbye",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "gui": "electron-vite build && node e2e/gui.mjs",
    "deploy-supervisor": "node ../../scripts/deploy-supervisor.mjs",
    "package": "node ../../scripts/make-icon.mjs && pnpm deploy-supervisor && electron-vite build && electron-builder --mac --config electron-builder.yml",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@crew/shared": "workspace:*",
    "@crew/supervisor": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "playwright": "^1.62.1",
    "vite": "^7.1.5"
  }
}
