{
  "name": "@crew/desktop",
  "productName": "Standbye",
  "version": "0.1.0",
  "description": "BYOK desktop app for 24/7 agent teams",
  "author": "Standbye <hello@navid.tr>",
  "homepage": "https://standbye.navid.tr",
  "repository": "https://github.com/mirzaaghazadeh/StandBye",
  "license": "Apache-2.0",
  "private": true,
  "main": "./out/main/index.js",
  "//desktopName": "Read by electron-builder (with linux.syncDesktopName) as the .desktop file name and the app_id/WM_CLASS Linux desktops match running windows against.",
  "desktopName": "standbye.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "node --test \"test/*.test.mjs\"",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "gui": "electron-vite build && node e2e/gui.mjs",
    "deploy-supervisor": "node ../../scripts/deploy-supervisor.mjs",
    "bundle": "pnpm deploy-supervisor && electron-vite build",
    "package": "pnpm bundle && electron-builder --config electron-builder.yml",
    "package:mac": "pnpm bundle && electron-builder --mac --config electron-builder.yml",
    "package:win": "pnpm bundle && electron-builder --win --config electron-builder.yml",
    "package:linux": "pnpm bundle && electron-builder --linux --config electron-builder.yml",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@crew/shared": "workspace:*",
    "@crew/supervisor": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "simple-icons": "^16.29.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "playwright": "^1.62.1",
    "vite": "^7.1.5"
  }
}
