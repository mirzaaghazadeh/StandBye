    },
    {
      "pattern": "Bash(gh*)",
      "behavior": "allow"
    },
    {
      "pattern": "Bash(pnpm*)",
      "behavior": "allow"
    },
    {
      "pattern": "Bash(git push*main*)",
      "behavior": "allow",
      "label": "Push to main"
    },
    {
      "pattern": "Bash(git push*master*)",
      "behavior": "allow",
      "label": "Push to master"
    },
    {
      "pattern": "Bash(git push --force*)",
      "behavior": "block",
      "label": "Force push"
    },
    {
      "pattern": "Bash(curl*)",
      "behavior": "allow",
      "label": "Network call"
    },
    {
      "pattern": "Bash(*)",
      "behavior": "allow"
