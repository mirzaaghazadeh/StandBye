    {
      "pattern": "Read",
      "behavior": "allow"
    },
    {
      "pattern": "Edit",
      "behavior": "allow"
    },
    {
      "pattern": "Write",
      "behavior": "allow"
    },
    {
      "pattern": "Glob",
      "behavior": "allow"
    },
    {
      "pattern": "Grep",
      "behavior": "allow"
    },
    {
      "pattern": "WebFetch",
      "behavior": "allow",
      "label": "Fetch a web page"
    },
    {
      "pattern": "WebSearch",
      "behavior": "allow"
    },
    {
      "pattern": "mcp__team__*",
      "behavior": "allow"
    }
